# Challenge data and material: pseudonymised, hackathon-only, must NOT be published or uploaded.
# Everyone downloads the zip from the organisers' SharePoint folder (see SETUP.md).
repte-horaris-escola/paquet/
repte-horaris-escola/validacio/*.csv
planols/
*.pdf
*.zip
# Exported reports embed tables from the data: generate locally, don't commit
*.html

# Secrets (LLM key for level 3): each person keeps their own local copy, never commit it.
# The template with empty values (nivell3/.env.example) IS committed.
.env
!.env.example

# Virtual environment (each person creates their own, never commit it)
.venv/
venv/

# Python caches
__pycache__/
*.pyc

# Jupyter checkpoints
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Saved chats of the level 3 web (may contain schedule/incident data): local only
nivell3/xats/

# Floor-plan images rendered from planols/ by the dashboard (same rule as planols/: local only)
dashboard/.cache/

nivell2/p52_torns/web-lot/ronda*/
nivell2/p52_torns/web-lot/resultats.jsonl
